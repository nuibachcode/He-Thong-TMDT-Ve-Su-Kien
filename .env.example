# ============================================================
# TicketGo - bien moi truong cho docker compose
# Copy file nay thanh .env roi chinh sua. KHONG commit .env.
#   Copy-Item .env.example .env
# ============================================================

# --- Cong expose ra host ---
GATEWAY_PORT=8080
FRONTEND_PORT=5173
CORE_API_PORT=8081
AI_SERVICE_PORT=8082

# --- PostgreSQL (dung chung ha tang, moi service mot database) ---
POSTGRES_USER=tmdt
POSTGRES_PASSWORD=tmdt123
POSTGRES_DB=ticketgo
POSTGRES_PORT=5432
CORE_DB=core_db
AI_DB=ai_db

# --- MongoDB ---
MONGO_PORT=27017
MONGO_DB=ai

# --- Redis ---
REDIS_PORT=6379

# --- RabbitMQ ---
RABBITMQ_USER=tmdt
RABBITMQ_PASSWORD=tmdt123
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# --- Bao mat JWT: BAT BUOC >= 32 ky tu, dung chung cho core-api + gateway + ai-service ---
JWT_SECRET=dev-only-secret-key-change-me-please-32bytes-min

# --- AI provider: mock | gemini ---
# mock  = chay offline, embedding lexical + tra loi extractive (khong can key)
# gemini = goi Gemini API cho chat + embedding (can GEMINI_API_KEY)
AI_PROVIDER=mock
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
AI_EMBEDDING_DIMENSION=768
# Doi provider (mock <-> gemini) thi nen bat reindex lan dau; service cung tu phat hien provider moi.
AI_REINDEX_ON_START=false
AI_CACHE_ENABLED=true
AI_RATE_LIMIT_ENABLED=true
AI_RATE_LIMIT_PER_MINUTE=20

# --- CORS (frontend dev / preview / production) ---
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://localhost:8080

# --- Chi dung khi chay backend local voi MySQL (khong bat buoc) ---
DB_URL=jdbc:mysql://localhost:3306/tmdt?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Ho_Chi_Minh&allowPublicKeyRetrieval=true&useSSL=false
DB_USER=tmdt
DB_PASSWORD=tmdt123
