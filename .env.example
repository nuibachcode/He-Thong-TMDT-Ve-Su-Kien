# ============================================================
# TicketGo - bien moi truong cho docker compose
# Copy file nay thanh .env roi chinh sua. KHONG commit .env.
#   Copy-Item .env.example .env
# ============================================================

# --- Cong expose ra host ---
GATEWAY_PORT=8080
FRONTEND_PORT=5173
POSTGRES_PORT=5432
MONGO_PORT=27017
REDIS_PORT=6379
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# --- PostgreSQL: moi service mot database ---
POSTGRES_USER=tmdt
POSTGRES_PASSWORD=tmdt123
POSTGRES_DB=ticketgo

# --- RabbitMQ ---
RABBITMQ_USER=tmdt
RABBITMQ_PASSWORD=tmdt123

# --- Bao mat JWT: BAT BUOC >= 32 ky tu, dung chung identity + gateway ---
JWT_SECRET=dev-only-secret-key-change-me-please-32bytes-min

# --- AI provider: mock | gemini ---
# mock   = chay offline, embedding lexical + tra loi extractive
# gemini = goi Gemini API (can GEMINI_API_KEY)
AI_PROVIDER=mock
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-3.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
AI_EMBEDDING_DIMENSION=768
# Doi provider thi nen bat reindex lan dau; service cung tu phat hien provider moi.
AI_REINDEX_ON_START=false
AI_CACHE_ENABLED=true
AI_RATE_LIMIT_ENABLED=true
AI_RATE_LIMIT_PER_MINUTE=20

# --- Payment: mock (sandbox noi bo) | vnpay (adapter se bo sung) ---
PAYMENT_PROVIDER=mock

# --- CORS (frontend dev / preview) ---
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173
